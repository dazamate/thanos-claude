# Claude Code state and secrets. Never managed, so `chezmoi add` refuses them too.
.claude/.credentials.json
.claude/history.jsonl
.claude/projects/**
.claude/file-history/**
.claude/session-env/**
.claude/sessions/**
.claude/shell-snapshots/**
.claude/paste-cache/**
.claude/cache/**
.claude/debug/**
.claude/backups/**
.claude/plugins/**
.claude/skills/synced/**
.claude/chromiumfish/**
.claude/context-mode/**
.claude/hooks/context-mode-cache-heal.mjs
.claude/.caveman-*
.claude/.caveman-*/**
.config/caveman/**
.headroom/**
**/__pycache__/**

# The `claude` wrapper is added to the rc file of each shell that's installed.
{{- if not (lookPath "zsh") }}
.zshrc
{{- end }}

# RTK keeps its config in the OS's config directory.
{{- if ne .chezmoi.os "darwin" }}
Library/**
{{- end }}
{{- if ne .chezmoi.os "linux" }}
.config/rtk/**
{{- end }}

{{- if eq .chezmoi.os "windows" }}
# Native Windows isn't supported yet: the scripts and hooks need bash and jq.
.claude.json
.claude/hooks/**
.claude/statusline-command.sh
.config/thanos-claude/**
.bashrc
.zshrc
{{- end }}
