{{- if and (ne .chezmoi.os "windows") (index . "overlayRepo") -}}
#!/bin/bash
# Private overlay: clone or update it, and link its skills, rules, agents and
# commands into ~/.claude.
# Runs on every apply, before files, because the settings and MCP edits read it.
set -euo pipefail
{{ template "lib.sh" . }}

overlay={{ .overlayDir | quote }}
if [ -d "$overlay/.git" ]; then
  git -C "$overlay" pull --ff-only --quiet || warn "could not update the overlay at $overlay; using it as is"
  ok "overlay"
else
  log "cloning overlay into $overlay"
  mkdir -p "$(dirname "$overlay")"
  git clone --quiet {{ .overlayRepo | quote }} "$overlay"
fi

# Link an overlay file or folder into ~/.claude/<kind>/.
link_into() {
  local kind=$1 src=$2 name dest
  name=$(basename "$src")
  dest="$HOME/.claude/$kind/$name"
  if [ -L "$dest" ] && [ "$(readlink "$dest")" = "$src" ]; then
    ok "overlay $kind/$name"
    return
  fi
  if [ -e "$dest" ] && [ ! -L "$dest" ]; then
    # Replace a plain copy only when it matches the overlay's, so nothing is lost.
    if diff -rq -x __pycache__ "$src" "$dest" >/dev/null 2>&1; then
      rm -rf "$dest"
    else
      warn "$dest differs from the overlay's copy; leaving it alone"
      return
    fi
  fi
  mkdir -p "$HOME/.claude/$kind"
  ln -sfn "$src" "$dest"
  log "linked overlay $kind/$name"
}

# Skills are folders; rules, agents and commands are Markdown files.
for src in "$overlay"/skills/*/; do
  if [ -d "$src" ]; then link_into skills "${src%/}"; fi
done
for kind in rules agents commands; do
  for src in "$overlay/$kind"/*.md; do
    if [ -f "$src" ]; then link_into "$kind" "$src"; fi
  done
done
{{ end -}}
