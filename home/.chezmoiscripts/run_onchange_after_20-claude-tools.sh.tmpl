{{- if ne .chezmoi.os "windows" -}}
#!/bin/bash
# Claude Code tooling: MCP servers, CLIs, plugins and skills.
# Runs after files are applied. Every step checks first, so re-running is a no-op.
set -euo pipefail
{{ template "lib.sh" . }}

# --- codebase-memory-mcp ------------------------------------------------------
cbm_version={{ .versions.cbm | quote }}
if [ "$(codebase-memory-mcp --version </dev/null 2>/dev/null)" = "codebase-memory-mcp $cbm_version" ]; then
  ok "codebase-memory-mcp $cbm_version"
else
  log "installing codebase-memory-mcp $cbm_version"
  CBM_DOWNLOAD_URL="https://github.com/DeusData/codebase-memory-mcp/releases/download/v$cbm_version" \
    bash {{ joinPath .chezmoi.workingTree "vendor/cbm-install.sh" | quote }} --skip-config </dev/null
fi
codebase-memory-mcp config set auto_index true </dev/null >/dev/null
codebase-memory-mcp config set ui_enabled false </dev/null >/dev/null

# --- RTK ----------------------------------------------------------------------
# The oss edition is the Apache-2.0 build, without the BUSL-licensed engine.
rtk_version={{ .versions.rtk | quote }}
if [ "$(rtk --version 2>/dev/null)" = "rtk $rtk_version" ]; then
  ok "rtk $rtk_version"
else
  log "installing rtk $rtk_version"
  RTK_VERSION="v$rtk_version" RTK_EDITION=oss \
    sh {{ joinPath .chezmoi.workingTree "vendor/rtk-install.sh" | quote }} </dev/null
fi

# --- Headroom -----------------------------------------------------------------
# Local proxy that compresses each API request; `claude` runs through it (see
# ~/.config/thanos-claude/shell.sh). [proxy] includes the ONNX Kompress model and
# [code] the AST-aware code compressor. [ml] and [all] would add PyTorch, several
# GB that only Kompress's optional PyTorch backend uses. Python 3.12, because on
# 3.10 onnxruntime is held below 1.24, which may fail to load Kompress's 261 MB
# int8 model and fall back to the 601 MB one.
headroom_version={{ .versions.headroom | quote }}
if [ "$(headroom --version 2>/dev/null)" = "headroom, version $headroom_version" ]; then
  ok "headroom $headroom_version"
else
  log "installing headroom $headroom_version"
  uv tool install --quiet --force --python 3.12 "headroom-ai[proxy,code]==$headroom_version"
fi

# --- beads (bd) ---------------------------------------------------------------
# Dependency-aware task graph, one Dolt database per repo in .beads/. The
# SessionStart hook (~/.claude/hooks/beads-prime.sh) injects context only in
# repos that have a workspace. Installed from the pinned release asset with its
# published checksum, since upstream's installer always fetches latest.
beads_version={{ .versions.beads | quote }}
# True when dotted version $1 is newer than $2. bd's schema is forward-only,
# so an out-of-band newer bd must not be replaced by the pin.
version_gt() {
  awk -v a="$1" -v b="$2" 'BEGIN {
    n = split(a, x, "."); m = split(b, y, ".")
    for (i = 1; i <= (n > m ? n : m); i++) {
      ai = (i <= n ? x[i] + 0 : 0); bi = (i <= m ? y[i] + 0 : 0)
      if (ai > bi) exit 0
      if (ai < bi) exit 1
    }
    exit 1
  }'
}
bd_target="$HOME/.local/bin/bd"
bd_current=$("$bd_target" version 2>/dev/null || true)
if [[ "$bd_current" == "bd version $beads_version "* ]]; then
  ok "beads $beads_version"
else
  case "$(uname -s)-$(uname -m)" in
    Linux-x86_64|Linux-amd64)  beads_platform=linux_amd64 ;;
    Linux-aarch64|Linux-arm64) beads_platform=linux_arm64 ;;
    Darwin-x86_64)             beads_platform=darwin_amd64 ;;
    Darwin-arm64)              beads_platform=darwin_arm64 ;;
    *)                         beads_platform="" ;;
  esac
  if [ -z "$beads_platform" ]; then
    warn "no beads release for $(uname -s)-$(uname -m); skipping"
  elif [ -n "$bd_current" ] &&
       version_gt "$(printf '%s\n' "$bd_current" | awk '{print $3}')" "$beads_version"; then
    warn "installed $bd_current is newer than pinned $beads_version; leaving it alone (bump the pin to manage it)"
  else
    log "installing beads $beads_version"
    if [ -n "$bd_current" ]; then
      warn "replacing $bd_current with $beads_version"
    fi
    beads_archive="beads_${beads_version}_${beads_platform}.tar.gz"
    beads_base="https://github.com/gastownhall/beads/releases/download/v$beads_version"
    beads_tmp=$(mktemp -d)
    if curl -fsSL -o "$beads_tmp/$beads_archive" "$beads_base/$beads_archive" &&
       curl -fsSL -o "$beads_tmp/checksums.txt" "$beads_base/checksums.txt"; then
      beads_expected=$(awk -v target="$beads_archive" \
        '{name=$2; sub(/^\*/, "", name); if (name == target) {print $1; exit}}' \
        "$beads_tmp/checksums.txt")
      if [ -z "$beads_expected" ] || [ "$beads_expected" != "$(sha256 "$beads_tmp/$beads_archive")" ]; then
        warn "beads checksum missing or mismatched; refusing to install"
      elif ! tar -xzf "$beads_tmp/$beads_archive" -C "$beads_tmp"; then
        warn "beads archive did not extract; skipping"
      else
        beads_extracted="$beads_tmp/bd"
        [ -x "$beads_extracted" ] ||
          beads_extracted=$(find "$beads_tmp" -maxdepth 2 -type f -name bd -print -quit)
        if [ -z "$beads_extracted" ]; then
          warn "beads archive did not contain a bd binary"
        else
          mkdir -p "$HOME/.local/bin"
          install -m 0755 "$beads_extracted" "$bd_target"
          ok "beads $beads_version"
        fi
      fi
    else
      warn "could not download beads $beads_version; skipping"
    fi
    rm -rf "$beads_tmp"
  fi
fi
# Anonymous usage metrics stay off, matching RTK and Headroom.
"$bd_target" metrics off </dev/null >/dev/null 2>&1 || true

# --- codeburn -----------------------------------------------------------------
if ! have npm; then
  warn "npm not found; skipping codeburn"
elif [ "$(codeburn --version 2>/dev/null)" = {{ .versions.codeburn | quote }} ]; then
  ok "codeburn {{ .versions.codeburn }}"
else
  log "installing codeburn {{ .versions.codeburn }}"
  npm install -g --silent "codeburn@{{ .versions.codeburn }}"
fi

# --- gopls (for the gopls-lsp plugin) -----------------------------------------
if ! have go; then
  warn "Go not installed; skipping gopls (the gopls-lsp plugin needs it)"
elif gopls version 2>/dev/null | grep -q "gopls {{ .versions.gopls }}$"; then
  ok "gopls {{ .versions.gopls }}"
else
  log "installing gopls {{ .versions.gopls }}"
  go install "golang.org/x/tools/gopls@{{ .versions.gopls }}"
fi

# --- chromiumfish-web MCP server ----------------------------------------------
cf_repo="$HOME/projects/chromium-fish-mcp"
cf_dir="$HOME/.claude/chromiumfish"
if [ -d "$cf_repo/.git" ]; then
  ok "chromium-fish-mcp checkout"
else
  log "cloning chromium-fish-mcp"
  git clone --quiet {{ .repos.chromiumfish | quote }} "$cf_repo" ||
    { warn "clone failed; it's private, so run 'gh auth login && gh auth setup-git' and re-apply"; exit 1; }
fi
if [ -x "$cf_dir/venv/bin/python" ]; then
  ok "chromiumfish venv"
else
  log "creating chromiumfish venv"
  python3 -m venv "$cf_dir/venv"
fi
cf_installed=$("$cf_dir/venv/bin/python" -c 'import importlib.metadata as m; print(m.version("chromiumfish"))' 2>/dev/null || true)
if [ "$cf_installed" = {{ .versions.chromiumfish | quote }} ]; then
  ok "chromiumfish {{ .versions.chromiumfish }}"
else
  log "installing chromiumfish {{ .versions.chromiumfish }}"
  "$cf_dir/venv/bin/pip" install --quiet --upgrade pip
  "$cf_dir/venv/bin/pip" install --quiet "chromiumfish[mcp]=={{ .versions.chromiumfish }}"
fi
# `fetch` skips the download when this browser build is already cached.
"$cf_dir/venv/bin/chromiumfish" fetch >/dev/null
ok "chromiumfish browser"
mkdir -p "$cf_dir/mcp"
ln -sfn "$cf_repo/mcp/chromiumfish_web.py" "$cf_dir/mcp/chromiumfish_web.py"

# --- transcribe-youtube-mcp ---------------------------------------------------
yt_repo="$HOME/projects/transcribe-youtube-mcp"
if [ ! -d "$yt_repo" ]; then
  log "cloning transcribe-youtube-mcp"
  git clone --quiet {{ .repos.youtube | quote }} "$yt_repo" ||
    warn "could not clone transcribe-youtube-mcp; the youtube-transcript server will be unavailable"
fi
if [ -f "$yt_repo/pyproject.toml" ]; then
  uv sync --quiet --directory "$yt_repo"
  ok "transcribe-youtube-mcp environment"
fi

# --- Claude Code plugins ------------------------------------------------------
marketplaces=$(claude plugin marketplace list --json 2>/dev/null || echo '[]')
{{- range $name, $m := .plugins.marketplaces }}
{{- $source := $m.repo }}{{ if hasKey $m "ref" }}{{ $source = printf "%s#%s" $m.repo $m.ref }}{{ end }}
current=$(jq -r --arg n {{ $name | quote }} \
  '.[] | select(.name == $n) | .repo + (if .ref then "#" + .ref else "" end)' <<<"$marketplaces")
if [ "$current" = {{ $source | quote }} ]; then
  ok "marketplace {{ $name }}"
else
  if [ -n "$current" ]; then
    # The pin can only change by re-adding; its plugins are reinstalled below.
    log "re-pinning marketplace {{ $name }} ($current -> {{ $source }})"
    claude plugin marketplace remove {{ $name | quote }}
  else
    log "adding marketplace {{ $name }}"
  fi
  claude plugin marketplace add {{ $source | quote }}
fi
{{- end }}
plugins=$(claude plugin list --json 2>/dev/null || echo '[]')
{{- range .plugins.install }}
if jq -e --arg id {{ . | quote }} 'any(.[]; .id == $id)' <<<"$plugins" >/dev/null; then
  ok "plugin {{ . }}"
else
  log "installing plugin {{ . }}"
  claude plugin install {{ . | quote }}
fi
{{- end }}

# --- skills from upstream -----------------------------------------------------
# Copies each skill's folder at its pinned commit. A stamp file records which
# commit is installed, so unchanged skills are skipped.
install_skill() {
  local name=$1 repo=$2 src=$3 commit=$4
  local dest="$HOME/.claude/skills/$name" want="$repo@$commit:$src" tmp
  if [ "$(cat "$dest/.thanos-source" 2>/dev/null)" = "$want" ]; then
    ok "skill $name"
    return
  fi
  log "installing skill $name ($repo@${commit:0:7})"
  tmp=$(mktemp -d)
  git -C "$tmp" init --quiet
  git -C "$tmp" remote add origin "https://github.com/$repo.git"
  git -C "$tmp" config core.sparseCheckout true
  printf '/%s/\n' "$src" > "$tmp/.git/info/sparse-checkout"
  git -C "$tmp" fetch --quiet --depth 1 --filter=blob:none origin "$commit"
  git -C "$tmp" checkout --quiet FETCH_HEAD
  mkdir -p "$dest"
  cp -R "$tmp/$src/." "$dest/"
  printf '%s\n' "$want" > "$dest/.thanos-source"
  rm -rf "$tmp"
}
{{- range .skills }}
install_skill {{ .name | quote }} {{ .repo | quote }} {{ .path | quote }} {{ .commit | quote }}
{{- end }}

# --- playwright-bot-bypass skill dependencies ---------------------------------
skill="$HOME/.claude/skills/playwright-bot-bypass"
stamp="$skill/node_modules/.lock-sha256"
lock_sha=$(sha256 "$skill/package-lock.json")
if ! have npm; then
  warn "npm not found; skipping playwright-bot-bypass dependencies"
else
  if [ "$(cat "$stamp" 2>/dev/null)" = "$lock_sha" ]; then
    ok "playwright-bot-bypass node_modules"
  elif [ -d "$skill/node_modules" ] && (cd "$skill" && npm ls --silent >/dev/null 2>&1); then
    # Already satisfies the lock file (installed before this repo existed).
    printf '%s\n' "$lock_sha" > "$stamp"
    ok "playwright-bot-bypass node_modules"
  else
    log "installing playwright-bot-bypass dependencies"
    (cd "$skill" && npm ci --silent)
    printf '%s\n' "$lock_sha" > "$stamp"
  fi
  # Downloads the Chromium build only if this Playwright version's is missing.
  (cd "$skill" && npx --no-install playwright install chromium >/dev/null)
  ok "playwright chromium"
fi
{{ end -}}
